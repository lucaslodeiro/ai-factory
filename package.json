{
  "name": "ai-factory",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc && node scripts/copy-assets.mjs",
    "configure": "bash scripts/configure.sh",
    "dashboard": "tsx src/cli.ts dashboard",
    "uninstall": "node scripts/uninstall.mjs",
    "service": "bash scripts/services.sh",
    "dev": "tsx src/cli.ts",
    "factory": "tsx src/cli.ts",
    "test": "node --import tsx --test test/*.test.ts",
    "test:scripts": "bash scripts/test-macos-installer.sh && node scripts/test-maintenance.mjs && node scripts/test-uninstall.mjs && node scripts/test-configure.mjs && node scripts/test-dashboard-config.mjs",
    "test:all": "npm test && npm run test:scripts"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "better-sqlite3": "^12.2.0",
    "commander": "^14.0.0",
    "dotenv": "^17.2.2",
    "pino": "^9.9.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.3.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
