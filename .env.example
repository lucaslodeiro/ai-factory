# Runtime
FACTORY_DATA_DIR=.factory
FACTORY_POLL_INTERVAL_MS=15000

# GitHub
GITHUB_REPOSITORY=
GITHUB_DEFAULT_BRANCH=main

# Slack (notification only)
SLACK_WEBHOOK_URL=

# Agent command overrides (optional)
CODEX_COMMAND=codex
CLAUDE_COMMAND=claude

# Explicit comma-separated secret names allowed to be forwarded to agents.
AGENT_SECRET_ALLOWLIST=
