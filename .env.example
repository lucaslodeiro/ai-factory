# Relative paths resolve from AI_FACTORY_HOME (the installation home).
FACTORY_DATA_DIR=data
FACTORY_REPO_DIR=
FACTORY_INSTANCE_NAME=
FACTORY_POLL_INTERVAL_MS=15000
FACTORY_EXECUTION_TIMEOUT_MS=600000
# Automatic Builder corrections before the issue waits for human guidance.
FACTORY_MAX_FIX_CYCLES=1
FACTORY_BRIEF_TARGET_CHARS=4000
FACTORY_SPEC_TARGET_CHARS=20000
FACTORY_SUMMARY_TARGET_CHARS=600
FACTORY_MAX_QUESTIONS=5
FACTORY_MAX_HUMAN_DECISIONS=5
FACTORY_MAX_STORIES=5
FACTORY_RESULT_MAX_ITEMS=100
FACTORY_STRUCTURED_OUTPUT_RETRIES=2
FACTORY_RECOVERABLE_ERROR_RETRIES=1
FACTORY_TOKEN_BUDGET_GRACE_PERCENT=25
# Tokens an issue may consume across every run, cache included, before it waits for an approver
# to extend it with `/factory budget +<tokens>`.
FACTORY_ISSUE_BUDGET_TOKENS=5000000
# Roles allowed to run without reported usage (for example a role routed to Cursor). Otherwise a run
# without usage pauses the issue until an approver acknowledges it.
FACTORY_BUDGET_UNMETERED_ROLES=
# Operator-controlled shell command, never agent-controlled; empty disables verification.
# Runs in the worktree after Tester, bounded by FACTORY_VERIFY_TIMEOUT_MS.
FACTORY_VERIFY_COMMAND=
FACTORY_VERIFY_TIMEOUT_MS=1800000
FACTORY_CONTEXT_BUDGET_BYTES=200000
FACTORY_ARTIFACT_RETENTION_DAYS=30
# Optional JSON object. Keys are exact role ids or provider/model pairs.
FACTORY_CONTEXT_BUDGET_OVERRIDES={}
FACTORY_DASHBOARD_HOST=127.0.0.1
FACTORY_DASHBOARD_PORT=4173
GITHUB_REPOSITORY=
GITHUB_DEFAULT_BRANCH=main
# Exact GitHub logins allowed to answer and approve specs.
FACTORY_APPROVERS=
SLACK_WEBHOOK_URL=
CODEX_COMMAND=codex
CLAUDE_COMMAND=claude
CURSOR_COMMAND=cursor-agent
GIT_COMMAND=git
# Only these extra environment variables are forwarded to worker processes.
AGENT_SECRET_ALLOWLIST=

# direct-v1 role routing. Use auto to let the selected provider choose its
# recommended/default model.
PRODUCT_ARCHITECT_PROVIDER=claude
PRODUCT_ARCHITECT_MODEL=auto
DESIGNER_PROVIDER=claude
DESIGNER_MODEL=auto
DEVELOPER_PROVIDER=codex
DEVELOPER_MODEL=auto
QA_PROVIDER=codex
QA_MODEL=auto
REVIEWER_PROVIDER=claude
REVIEWER_MODEL=auto

# Optional Chrome/Chromium executable; otherwise discover installed Chrome.
# FACTORY_BROWSER_EXECUTABLE=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome
