# Absolute paths recommended; one data directory per target repository.
FACTORY_DATA_DIR=.factory
FACTORY_REPO_DIR=
FACTORY_POLL_INTERVAL_MS=15000
FACTORY_EXECUTION_TIMEOUT_MS=1800000
FACTORY_MAX_FIX_CYCLES=3
FACTORY_DASHBOARD_HOST=127.0.0.1
FACTORY_DASHBOARD_PORT=4173
GITHUB_REPOSITORY=
GITHUB_DEFAULT_BRANCH=main
# Exact GitHub logins allowed to answer and approve specs.
FACTORY_APPROVERS=
SLACK_WEBHOOK_URL=
CODEX_COMMAND=codex
CLAUDE_COMMAND=claude
GIT_COMMAND=git
# Only these extra environment variables are forwarded to worker processes.
AGENT_SECRET_ALLOWLIST=

# balanced-v3 provider defaults. Role-specific routing below controls execution.
CODEX_MODEL_FAST=gpt-5.6-luna
CODEX_MODEL_BALANCED=gpt-5.6-terra
CODEX_MODEL_STRONG=gpt-5.6-sol
CLAUDE_MODEL_FAST=sonnet
CLAUDE_MODEL_BALANCED=sonnet
CLAUDE_MODEL_STRONG=opus

# Provider and task-aware model profiles for every factory role.
PRODUCT_ARCHITECT_PROVIDER=claude
PRODUCT_ARCHITECT_MODEL_FAST=sonnet
PRODUCT_ARCHITECT_MODEL_BALANCED=sonnet
PRODUCT_ARCHITECT_MODEL_STRONG=opus
DEVELOPER_PROVIDER=codex
DEVELOPER_MODEL_FAST=gpt-5.6-luna
DEVELOPER_MODEL_BALANCED=gpt-5.6-terra
DEVELOPER_MODEL_STRONG=gpt-5.6-sol
QA_PROVIDER=codex
QA_MODEL_FAST=gpt-5.6-luna
QA_MODEL_BALANCED=gpt-5.6-terra
QA_MODEL_STRONG=gpt-5.6-sol
REVIEWER_PROVIDER=claude
REVIEWER_MODEL_FAST=sonnet
REVIEWER_MODEL_BALANCED=sonnet
REVIEWER_MODEL_STRONG=opus
