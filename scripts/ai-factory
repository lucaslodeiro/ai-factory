#!/usr/bin/env bash
set -euo pipefail

script=${BASH_SOURCE[0]}
while [[ -L $script ]]; do
  directory=$(CDPATH= cd -- "$(dirname -- "$script")" && pwd)
  target=$(readlink "$script")
  [[ $target == /* ]] && script=$target || script=$directory/$target
done
launcher_root=$(CDPATH= cd -- "$(dirname -- "$script")/.." && pwd)
if [[ ${launcher_root##*/} == engine ]]; then home=${AI_FACTORY_HOME:-${launcher_root%/engine}}; root=$launcher_root
else home=${AI_FACTORY_HOME:-$launcher_root}; root=$home/engine; [[ -d $root ]] || root=$launcher_root
fi
export AI_FACTORY_HOME="$home"
command=${1:-help}
[[ $# == 0 ]] || shift

case $command in
  uninstall) exec node "$root/scripts/uninstall.mjs" "$@";;
  update)
    explicit_mode=false
    for argument in "$@"; do [[ $argument == --restart-services || $argument == --start-services ]] && explicit_mode=true; done
    if "$explicit_mode"; then exec bash "$root/scripts/update.sh" "$@"; else exec bash "$root/scripts/update.sh" --restart-services "$@"; fi
    ;;
  service) exec bash "$root/scripts/services.sh" "$@";;
  configure) exec bash "$root/scripts/configure.sh" "$@";;
  version) exec node "$root/dist/src/cli.js" --version;;
  help|-h|--help)
    cat <<'EOF'
Usage:
  ai-factory <factory-command> [arguments]
  ai-factory service <action> <daemon|dashboard|all>
  ai-factory update [--start-services]
  ai-factory configure
  ai-factory uninstall [--yes] [--force]
  ai-factory version
  ai-factory help

Operations work from any directory. Workflow commands follow:
EOF
    node "$root/dist/src/cli.js" --help
    ;;
  *) exec node "$root/dist/src/cli.js" "$command" "$@";;
esac
